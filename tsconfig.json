{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist/runtime",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": ["packages/**/*.ts", "scripts/**/*.ts", "sites/**/*.ts"]
}
